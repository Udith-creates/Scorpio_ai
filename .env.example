# ── Google Cloud ─────────────────────────────────────────────────────────────
GCP_PROJECT_ID=scorpio-ai-2026

# ── AI ────────────────────────────────────────────────────────────────────────
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# ── Scraper ───────────────────────────────────────────────────────────────────
# YouTube Data API v3 key (optional — falls back to mock without it)
# https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEY=

# Vimeo personal access token (optional — improves rate limits)
# https://developer.vimeo.com/apps
VIMEO_TOKEN=

# Set to "false" to disable real video downloads (faster scans, less accurate)
ENABLE_VIDEO_DOWNLOAD=true

# ── Blockchain ────────────────────────────────────────────────────────────────
# Any EVM-compatible RPC endpoint
# Sepolia testnet (free):  https://rpc.sepolia.org
# Polygon mainnet (cheap): https://polygon-rpc.com
ETH_RPC_URL=https://rpc.sepolia.org

# 0x-prefixed private key of the wallet that will sign transactions
# Get free Sepolia ETH from: https://sepoliafaucet.com
ETH_PRIVATE_KEY=

# Address of the deployed ContentRegistry contract
# Run `python scripts/deploy.py` once to get this
CONTRACT_ADDRESS=
